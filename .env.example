# 실제 키/값은 .env 파일(이 파일과 같은 위치)에 넣으세요. .env는 절대 md 문서나 대화창에 붙여넣지 않습니다.

# Luxia (Saltlux) LLM API — persona-dashboard repo(github.com/sechun4686/persona-dashboard) 기준 확인된 기본값
LUXIA_API_URL=https://bridge.luxiacloud.com/luxia/v1/chat
LUXIA_MODEL=luxia3-llm-32b-0731
LUXIA_API_KEY=

# OpenSearch (retrieval 용도로 추정, RAG 구현 시 필요)
OPENSEARCH_HOST=
OPENSEARCH_PORT=9200
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
